# Leave empty for evidence excerpts without calling a language model.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional sentence-transformers model ID or local directory.
# Set before importing documents; changing this requires rebuilding the index.
EMBEDDING_MODEL=
EMBEDDING_DEVICE=auto
# Optional local cross encoder. Configuring makes it available; each request opts in.
# Does not require reindexing documents. Download first with scripts/prepare_reranker.py.
RERANKER_MODEL=
RERANKER_DEVICE=auto
RERANKER_CANDIDATES=10
# Relative to the working directory; run commands from the project root.
HF_HOME=data/models/cache
RAG_DB_PATH=data/knowledge.db
